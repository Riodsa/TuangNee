# LINE Messaging API Credentials (from https://developers.line.biz/console/)
LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token_here
LINE_CHANNEL_SECRET=your_channel_secret_here

# Database path
DB_PATH=icloud_bot.db

# Timezone for scheduling and status comparison
TIMEZONE=Asia/Bangkok

# Default Monthly Schedule (Can also be changed in chat via !schedule <day> <HH:MM>)
SCHEDULE_DAY=1
SCHEDULE_HOUR=9
SCHEDULE_MINUTE=0

# Total Monthly Cost in THB (split equally among group members)
TOTAL_COST=99

# Server configuration
PORT=8000
